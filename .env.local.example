# Copy to .env.local and fill in real values. Never commit .env.local.
# This file holds PLACEHOLDERS only — no real secrets.
# See the "Environment Variables" section in CLAUDE.md for full details
# (required vs optional, and which to mark "Sensitive" in Vercel).

# --- Supabase (required) ---
# Project URL and public anon key — safe to expose (shipped to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service-role key — SERVER ONLY, full DB access. Used by the Shopify webhook
# to write completed orders. Mark Sensitive in Vercel. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Admin allowlist (required for the /admin area) ---
# Comma-separated emails allowed into the Tee Studio admin.
ADMIN_EMAILS=you@example.com

# --- Shopify Storefront API (required — product data + cart, app/lib/shopify.ts) ---
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-storefront-public-token

# --- Shopify order webhook (required if the order/paid webhook is registered) ---
# Shared secret used to verify inbound webhook HMAC signatures.
# SERVER ONLY. Mark Sensitive in Vercel.
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret-here

# --- Cloudinary (optional — only for AI/PSD/EPS upload conversion in the designer) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# --- Shopify Customer Account API (Phase 1 — required for customer login) ---
# Storefront domain used to fetch the OIDC discovery document at
# https://${SHOPIFY_STOREFRONT_DOMAIN}/.well-known/openid-configuration
SHOPIFY_STOREFRONT_DOMAIN=your-store-domain.com
# Confidential OAuth client credentials from Shopify admin → Headless →
# Customer Account API. The SECRET is SERVER ONLY — mark Sensitive in Vercel.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your-client-id-here
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=your-client-secret-here

# Public origin used to build the OAuth redirect_uri (must match what's
# registered in Shopify). Production: https://create.tshirtdeli.com
# Dev: your Cloudflare Tunnel hostname, e.g. https://tee-dev.example.dev
NEXT_PUBLIC_APP_URL=https://create.tshirtdeli.com

# --- Debug endpoint gate (optional) ---
# Shared secret required as ?secret=... to access /api/debug. If unset, the
# endpoint fails closed (404). SERVER ONLY. Mark Sensitive in Vercel.
DEBUG_SECRET=generate-a-strong-random-32plus-char-value
