# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://yatiairlyensmcwbpldx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin allowlist (comma-separated emails for Tee Studio admin) ---
ADMIN_EMAILS=dplumb@mac.com

# --- Shopify Storefront API (existing, used by app/lib/shopify.ts) ---
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=tshirtdeli.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# --- Shopify Customer Account API (Phase 1) ---
# Storefront domain used to fetch the OIDC discovery document at
# https://${SHOPIFY_STOREFRONT_DOMAIN}/.well-known/openid-configuration
SHOPIFY_STOREFRONT_DOMAIN=tshirtdeli.com
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=

# Public origin used to build the OAuth redirect_uri.
# Production: https://create.tshirtdeli.com
# Dev: your Cloudflare Tunnel hostname, e.g. https://tee-dev.example.dev
NEXT_PUBLIC_APP_URL=https://create.tshirtdeli.com
